generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  packages    Package[]
}

model Package {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tier        String
  name        String
  description String?
  price       Float
  warranty    String?
  features    String
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  estimates   Estimate[]
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  createdAt DateTime   @default(now())
  estimates Estimate[]
}

model Estimate {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  packageId     String?
  package       Package?  @relation(fields: [packageId], references: [id])
  status        String    @default("draft")
  notes         String?
  signatureData String?
  signedAt      DateTime?
  totalAmount   Float?
  customPrice   Float?
  token         String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoice       Invoice?
}

model Invoice {
  id                    String    @id @default(cuid())
  estimateId            String    @unique
  estimate              Estimate  @relation(fields: [estimateId], references: [id])
  status                String    @default("pending")
  totalAmount           Float
  paidAmount            Float     @default(0)
  stripePaymentIntentId String?
  stripeSessionId       String?
  paidAt                DateTime?
  receiptSentAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model DoorEstimatorConfig {
  id              String   @id @default("default")
  version         Int      @default(1)
  pricebookName   String
  effectiveDate   DateTime?
  multiplier      Float    @default(3)
  roundingMethod  String   @default("nearest_hundred_minus_one")
  removalIncluded Boolean  @default(true)
  catalogJson     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TuneUpLead {
  id           String    @id @default(cuid())
  token        String    @unique @default(cuid())
  status       String    @default("quiz")
  firstName    String
  email        String?
  phone        String?
  zip          String?
  score        Int
  tier         String
  answersJson  String
  preferredDay String?
  preferredWindow String?
  emailOptOut  Boolean   @default(false)
  dripStage    Int       @default(0)
  nextDripAt   DateTime?
  lastEmailAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Self-scheduled $129 tune-up appointment requests from /tuneup.
// status: requested | pending_confirmation | confirmed | call_required |
//         service_area_review | cancelled  (see lib/tuneup/booking.ts)
model TuneUpBooking {
  id                     String    @id @default(cuid())
  token                  String    @unique @default(cuid())
  reference              String    @unique
  status                 String    @default("requested")
  serviceType            String    @default("tuneup") // tuneup | general
  firstName              String
  lastName               String?
  phone                  String
  email                  String?
  preferredContactMethod String    @default("text")
  serviceAddress         String?
  city                   String?
  state                  String?
  zipCode                String?
  doorCount              String?
  doorOperatingStatus    String?
  issueType              String?
  specialConditions      String?
  notes                  String?
  requestedDate          String?
  requestedWindow        String?
  serviceAreaEligible    Boolean?
  source                 String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  gclid                  String?
  fbclid                 String?
  consentAccepted        Boolean   @default(false)

  // --- repair-request landing pages (/lp/*; serviceType "repair") ---
  // submissionId: generated by the form, so a retry or double-tap returns
  // the SAME record instead of a second lead (and a second email).
  submissionId           String?   @unique
  residentialConfirmed   Boolean?
  landingPath            String?   // e.g. /lp/garage-door-repair — never the raw query string
  landingKeyword         String?   // key from lib/repair/landing.ts (allowlisted), not the searcher's words
  utmTerm                String?
  gbraid                 String?
  wbraid                 String?
  // office notification: pending -> sending -> sent | failed (retried)
  notifyStatus           String?
  notifyAttempts         Int       @default(0)
  notifyError            String?
  notifiedAt             DateTime?
  // speed to lead — set by the office via the Field app, never by automation
  firstResponseAt        DateTime?
  bookedAt               DateTime?
  fieldJobId             Int?

  // --- shop product requests (website Shop: openers, doors) ---
  // requestSnapshot: the versioned, validated request summary (JSON, schema "straightshot.shop-request" v1) saved
  // with the booking. The customer email, the website confirmation and its PDF are all rendered from it, so a later
  // price or catalog change never rewrites what the customer asked for. submissionId (above) makes resends idempotent.
  requestSnapshot        String?
  // customer summary email: pending -> sending -> sent | failed (retried by the notify timer)
  customerEmailStatus    String?
  customerEmailAttempts  Int       @default(0)
  customerEmailError     String?
  customerEmailSentAt    DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model DoorEstimate {
  id                  String    @id @default(cuid())
  token               String    @unique @default(cuid())
  mode                String
  status              String    @default("draft")
  customerName        String?
  phone               String?
  email               String?
  address             String?
  city                String?
  zip                 String?
  timeline            String?
  source              String?
  emailOptOut         Boolean   @default(false)
  dripStage           Int       @default(0)
  nextDripAt          DateTime?
  lastEmailAt         DateTime?
  configurationJson   String
  vendorCostSnapshot  Float
  retailPriceSnapshot Float
  pricingSnapshotJson String
  notes               String?
  signatureData       String?
  signedAt             DateTime?
  convertedEstimateId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
