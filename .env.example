# Copy to .env and fill in. Nothing here is required for local development —
# unset integrations fall back to safe logged mocks.

# --- core ---
DATABASE_URL="file:./dev.db"
PUBLIC_BASE_URL="http://localhost:3000"          # canonical base for links in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- door estimator ---
DOOR_ESTIMATOR_ADMIN_KEY=""                       # 48+ char secret for admin/drip endpoints
DOOR_ESTIMATOR_ALLOWED_ORIGIN="https://straightshotoverhead.com"

# --- lead + booking notifications (SMTP; see lib/email.ts) ---
SMTP_HOST=""                                      # e.g. smtp.protonmail.ch
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""                                      # must align with the sending domain's DKIM
LEAD_ALERT_TO=""                                  # office inbox for door/quiz lead alerts
BOOKING_ALERT_TO=""                               # inbox for tune-up appointment requests (falls back to LEAD_ALERT_TO)

# --- tune-up booking provider (lib/tuneup/booking-provider.ts) ---
# "mock" (default) offers windows from SCHEDULING config and this app's own
# open requests. Future adapters: google | jobber | housecallpro | servicetitan
BOOKING_PROVIDER="mock"
GOOGLE_CALENDAR_ID=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# --- optional SMS / email vendors (not wired yet; adapter notes in
#     lib/tuneup/booking-emails.ts) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
RESEND_API_KEY=""

# --- optional CRM webhook (POST the booking record on creation) ---
CRM_WEBHOOK_URL=""

# --- repair landing pages (/lp/*) ---
REPAIR_LEAD_ALERT_TO="ricky@straightshotoverhead.com"   # office email for repair requests (this is the default)
FIELDAPP_PUBLIC_URL="https://straightshotservice.com"   # link target in that email (login-protected)
# Google tag — BUILD-TIME values (rebuild after changing). Leave empty until the
# conversion action exists; with them empty, no Google tag loads at all.
NEXT_PUBLIC_GOOGLE_ADS_ID=""                            # e.g. AW-123456789
NEXT_PUBLIC_ADS_REPAIR_LEAD_SEND_TO=""                  # e.g. AW-123456789/AbCdEfGhIjk

# --- Google Ads API (NOT used yet — only for a future automated build/upload).
#     Values go in the server .env only; never in chat or git. See setup/README.md §3.
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""                         # manager account ID, if one is used
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""

# --- website shop requests (openers, doors): see SHOP-BOOKING-STANDARD.md ---
SHOP_BOOKING_KEY=""                               # shared with the website's SHOP_BOOKING_KEY (owner-generated, 32+ chars)
SHOP_ASSET_BASE="https://straightshotoverhead.com/assets/"   # where product images in the customer summary email load from
